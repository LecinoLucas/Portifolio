# ==========================================
# Configurações do Backend — Portfólio (LES v2.2.0)
# ==========================================

# Ambiente de execução (development | production | test)
NODE_ENV=development

# Porta do servidor HTTP
PORTA=3001

# String de conexão PostgreSQL (ex: Supabase, Neon, Render ou Local)
# Formato: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio?schema=public

# Origens CORS permitidas (separadas por vírgula ou * para desenvolvimento)
CORS_ORIGEM=http://localhost:5173,http://127.0.0.1:5173

# Limite de taxa de envio de contato por IP (proteção anti-abuso)
TAXA_LIMITE_CONTATO_MAX=5
TAXA_LIMITE_CONTATO_JANELA_MINUTOS=15
