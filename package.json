{
  "name": "portfolio-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@portfolio/frontend",
    "dev:frontend": "npm run dev --workspace=@portfolio/frontend",
    "dev:backend": "npm run dev --workspace=@portfolio/backend",
    "build": "npm run build --workspaces --if-present",
    "build:frontend": "npm run build --workspace=@portfolio/frontend",
    "build:backend": "npm run build --workspace=@portfolio/backend",
    "test": "npm run test --workspaces --if-present",
    "test:frontend": "npm run test --workspace=@portfolio/frontend",
    "test:backend": "npm run test --workspace=@portfolio/backend",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "set-domain": "node scripts/set-site-url.mjs"
  }
}
