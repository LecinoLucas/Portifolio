{
  "name": "portfolio-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@portfolio/frontend",
    "dev:frontend": "npm run dev --workspace=@portfolio/frontend",
    "dev:backend": "npm run dev --workspace=@portfolio/backend",
    "dev:all": "concurrently -k -n \"smtp,backend,frontend\" -c \"magenta,blue,green\" \"npm run smtp:simulador\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "smtp:simulador": "node scripts/local-smtp-simulador.mjs",
    "build": "npm run build --workspaces --if-present",
    "build:frontend": "npm run build --workspace=@portfolio/frontend",
    "build:backend": "npm run build --workspace=@portfolio/backend",
    "test": "npm run test --workspaces --if-present",
    "test:frontend": "npm run test --workspace=@portfolio/frontend",
    "test:backend": "npm run test --workspace=@portfolio/backend",
    "lint": "eslint frontend/src backend/src backend/tests packages/contracts/src",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspace=@portfolio/backend",
    "prisma:migrate": "npm run prisma:migrate --workspace=@portfolio/backend",
    "prisma:seed": "npm run prisma:seed --workspace=@portfolio/backend",
    "set-domain": "node scripts/set-site-url.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
